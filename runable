# Practice monorepo — how to start each scaffold
# Run these from the practice/ directory.

# --- Frontend (Vite + React + TypeScript) ---
cd frontend
npm run dev
# → http://localhost:5173

# --- Backend (FastAPI + uvicorn) ---
# Uses 8001 because 8000 is often taken (e.g. Docker). Change if you prefer.
cd backend
uv run uvicorn main:app --reload --port 8001
# → http://localhost:8001
# → docs at http://localhost:8001/docs (empty app until you add routes)
